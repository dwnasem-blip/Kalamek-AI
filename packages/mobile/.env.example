# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# API Keys (Don't commit real keys!)
# These are managed by environment-specific configurations

# Development/Production
EXPO_PUBLIC_ENV=development

# For Supabase Edge Functions only (Backend configuration)
# WARNING: Never put these in the app!
# Store these as Supabase Edge Function secrets instead
# OPENAI_API_KEY=sk-...
# ELEVENLABS_API_KEY=...
# RUNWAY_API_KEY=...
