{
  "expo": {
    "name": "Kalamek AI",
    "slug": "kalamek-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "kalamek",
    "splash": {
      "image": "./app/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.wordaljouri.kalamek",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select videos",
        "NSCameraUsageDescription": "This app needs access to your camera for video recording",
        "NSMicrophoneUsageDescription": "This app needs access to your microphone for audio recording",
        "NSLocalNetworkUsageDescription": "This app needs local network access",
        "NSBonjourServiceTypes": ["_services._dns-sd._udp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.wordaljouri.kalamek",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./app/assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": false
        }
      ],
      [
        "expo-av"
      ],
      [
        "expo-file-system"
      ],
      [
        "expo-document-picker"
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Kalamek AI to access your photos",
          "videoPermission": "Allow Kalamek AI to access your videos",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      },
      "apiEnvironment": "development"
    },
    "owner": "wordaljouri",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
