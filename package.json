{
  "name": "kalamek-ai",
  "version": "1.0.0",
  "description": "Professional AI Video Captioning App with Arabic Support",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "eject": "expo eject",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:migrate": "supabase migration up",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "test:supabase": "node scripts/test-supabase.js",
    "test:openai": "node scripts/test-openai.js",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android"
  },
  "dependencies": {
    "expo": "^51.0.0",
    "expo-router": "^3.5.0",
    "expo-file-system": "^16.0.0",
    "expo-document-picker": "^11.10.0",
    "expo-video": "^1.0.0",
    "expo-media-library": "^15.0.0",
    "expo-av": "^14.0.0",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "typescript": "^5.3.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@supabase/supabase-js": "^2.38.0",
    "@supabase/auth-js": "^2.59.0",
    "zustand": "^4.4.0",
    "@react-query/native": "^3.39.0",
    "react-query": "^3.39.0",
    "react-hook-form": "^7.51.0",
    "zod": "^3.22.0",
    "dayjs": "^1.11.10",
    "axios": "^1.6.0",
    "openai": "^4.26.0",
    "expo-av": "^14.0.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.7.0",
    "react-native-screens": "^3.29.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-svg": "^14.1.0",
    "expo-linear-gradient": "^13.0.0",
    "lucide-react-native": "^0.263.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "@testing-library/react-native": "^12.4.0",
    "@testing-library/jest-native": "^5.4.0",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.0",
    "supabase": "^1.137.0",
    "dotenv": "^16.4.0",
    "dotenv-cli": "^7.0.0",
    "esbuild": "^0.19.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "expo": {
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-av"
      ]
    ]
  }
}
