# ==================== SUPABASE ====================
# Get these from Supabase > Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# IMPORTANT: This should ONLY be in .env.local on your backend
# Do NOT commit the actual key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ==================== OPENAI ====================
# Get this from platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ==================== APP SETTINGS ====================
EXPO_PUBLIC_API_ENVIRONMENT=development
# development, staging, production

# ==================== REVENUECAT ====================
# For App Store & Play Store subscriptions
REVENUECAT_API_KEY=

# ==================== OTHER ====================
EXPO_PUBLIC_APP_VERSION=1.0.0
